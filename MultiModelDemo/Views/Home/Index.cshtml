@{
    ViewData["Title"] = "Home Page";
}
@if (TempData["error"] != null)
{
    <div class="container-fluid p-3 bg-light text-danger">
        <b>Error: @TempData["error"]</b>
    </div>
}

<div class="container-fluid">
    <h1>Search Student Course Wise</h1>
    <form name="fr" action="Home/Search" method="post">
        <div class="row">
            <div class="col-sm-12 col-lg-6">
        <div>
            <label class="form-label">Enter Course ID</label>
			<input type="text" name="id" class="form-control" />
        </div>
        <div>
			<input type="submit" value="Search" class="btn btn-primary mt-2" />
        </div>
            </div>
        </div>
    </form>
</div>

<hr mb-3/>

<div class="container-fluid">
    <h1>Search Fee Student Wise</h1>
    <form name="fr" action="Home/SearchStu" method="post">
        <div class="row">
            <div class="col-sm-12 col-lg-6">
                <div>
                    <label class="form-label">Enter Student ID</label>
                    <input type="text" name="id" class="form-control" />
                </div>
                <div>
                    <input type="submit" value="Search" class="btn btn-primary mt-2" />
                </div>
            </div>
        </div>
    </form>
</div>