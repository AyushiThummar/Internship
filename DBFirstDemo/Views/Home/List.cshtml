@model List<DBFirstDemo.Models.Student>
@{
    ViewData["Title"] = "Details of students";
}
@if (TempData["message"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
		<strong>Message!</strong> @TempData["message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<h1>Student List</h1>

<p>
    <a class="btn btn-success" asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Roll</th>
            <th>Name</th>
            <th>Gender</th>
            <th>Date of Birth</th>
            <th>Phone</th>
        </tr>
    </thead>

    <tbody>
    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.Roll</td>
                <td>@student.StuName</td>
                <td>@student.StuGender</td>
                <td>@student.StuDob</td>
                <td>@student.StuPhne</td>
                <td>
                    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@student.Roll">Edit</a>|
                    <a class="btn btn-warning" asp-action="Details" asp-route-id="@student.Roll">Details</a>|
                    <a class="btn btn-danger" asp-action="Delete" asp-route-id="@student.Roll">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>