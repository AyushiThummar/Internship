@model DBFirstDemo.Models.Student

<style>
    .delete-container {
        width: 450px;
        margin: 30px auto;
        padding: 25px;
        border: 1px solid #ddd;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .student-info {
        margin: 20px 0;
    }

        .student-info dt {
            font-weight: bold;
            margin-top: 10px;
        }

        .student-info dd {
            margin-left: 0;
            padding: 8px;
            background-color: #f5f5f5;
        }

    .btn {
        padding: 8px 15px;
        border: none;
        border-radius: 4px;
        color: white;
        text-decoration: none;
        cursor: pointer;
        background-color: #dc3545;
    }

    .back-btn {
        background-color: #555;
    }
</style>

<div class="delete-container">

    <h1>Delete Student</h1>

    <p>Are you sure you want to delete this student?</p>

    <dl class="student-info">

        <dt>Roll</dt>
        <dd>@Model.Roll</dd>

        <dt>Name</dt>
        <dd>@Model.StuName</dd>

        <dt>Gender</dt>
        <dd>@Model.StuGender</dd>

        <dt>Date of Birth</dt>
        <dd>@Model.StuDob</dd>

        <dt>Phone</dt>
        <dd>@Model.StuPhne</dd>

    </dl>

    <form asp-action="Delete" method="post">

        <input type="hidden" asp-for="Roll" />

        <button type="submit" class="btn">
            Delete
        </button>

        <a asp-action="List" class="btn back-btn">
            Back to List
        </a>

    </form>

</div>